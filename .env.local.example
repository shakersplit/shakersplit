# ============================================================================
# ShakerSplit — example environment configuration. Copy to .env.local and fill in.
#
# Variables prefixed with VITE_ are shipped to the browser bundle. NEVER put
# secrets there. Server-only secrets are bare-named.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project Settings → API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-side mirrors of the same URL + service-role key for API routes.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...     # WARNING: full DB access. Never ship to client.

# ── App URL ─────────────────────────────────────────────────────────────────
# Local dev uses localhost; production overrides this in Vercel env.
VITE_APP_URL=http://localhost:5173

# ── Resend SMTP (optional, but recommended for production) ──────────────────
# Used by `supabase config push` to set up custom SMTP on Supabase Auth.
# Sign up at resend.com → API Keys → Create.
RESEND_API_KEY=re_...

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# Created at console.cloud.google.com/apis/credentials → OAuth client → Web app.
# See docs/DEPLOYMENT.md step 4 for the full setup walkthrough.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is shipped to the client (VITE_), private key stays server-side.
VITE_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com

# ── AI food parser (optional) ───────────────────────────────────────────────
# Free Gemini API key from aistudio.google.com/apikey.
# Without this, /api/food-logs?action=parse-ai returns 503 (gracefully — form
# falls back to manual entry).
GEMINI_API_KEY=AIza...
